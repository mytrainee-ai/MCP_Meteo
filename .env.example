# Ключ, базовый URL и модель провайдера с поддержкой Responses API.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# Адрес погодного MCP-сервера.
MCP_URL=https://weather.chukai.io/mcp

# Лимиты одного запроса. Тайм-аут задаётся в секундах.
AGENT_MAX_STEPS=6
AGENT_MAX_TOOL_CALLS=10
REQUEST_TIMEOUT_SECONDS=30
DEBUG=false
